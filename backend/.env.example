# Backend environment configuration (copy to .env)
# .env is git-ignored; never commit real values.

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Application / pipeline versions. Reported by /api/v1/health.
# FEATURE_VERSION stays unset until feature orchestration is served (Phase 9).
# The feature registry itself is versioned independently (f0.3.0).
FEATURE_VERSION=
MODEL_VERSION=0.1.0

# Passage windowing (ADR-003): overlapping sentence windows, paragraph fallback.
PASSAGE_WINDOW=3
PASSAGE_STRIDE=1
PARAGRAPH_FALLBACK=true

# Rate limiting (ADR-006): in-memory sliding window, dev-only.
RATE_LIMIT_PER_MINUTE=60

# CORS: comma-separated allowed origins (dev defaults to localhost Next.js).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local causal-LM instrument (ADR-001). Pinned revision; weights are NOT
# loaded by the health endpoint. gpt2-medium revision on 2024-02-19.
LM_MODEL_NAME=gpt2-medium
LM_MODEL_REVISION=6dcaa7a952f72f9298047fd5137cd6e4f05f41da